# ============================================================
# LUSHIPOST — Variables d'environnement
# Copiez vers .env (local) ou configurez dans Vercel → Settings → Environment Variables
# ============================================================

# --- Base de données (PostgreSQL) ---
# Recommandé : Neon (https://neon.tech) ou Vercel Postgres
#
# DATABASE_URL = connexion poolée (runtime Vercel / app)
# DIRECT_URL   = connexion directe (migrations prisma db push)
# En local, Prisma utilise automatiquement DIRECT_URL (voir src/lib/prisma.ts)
#
# Exemple Neon :
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

DATABASE_URL="postgresql://user:password@localhost:5432/lushipost?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/lushipost?schema=public"

# --- Authentification (NextAuth.js) ---
# NEXTAUTH_SECRET : générez avec → openssl rand -base64 32
# NEXTAUTH_URL    : URL publique du site (sans slash final)

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-min-32-chars"

# --- Application ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="LUSHIPOST"

# --- Vercel (auto-injectées, ne pas définir manuellement) ---
# VERCEL_URL=https://votre-projet.vercel.app

# --- Optionnel : Object Storage (images / vidéos) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=

# --- Optionnel : SMTP newsletter ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="newsletter@lushipost.com"
